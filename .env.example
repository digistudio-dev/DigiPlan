# Identifiants OAuth Google (client de type « Application de bureau »), intégrés au build.
# Facultatif : sans eux, le propriétaire peut saisir ses propres identifiants dans
# Paramètres → Google Calendar. Voir docs/GOOGLE_CALENDAR.md.
# Copiez ce fichier en `.env` (jamais versionné) avant `npm run package`.
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
